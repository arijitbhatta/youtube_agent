# Copy this file to .env and fill in your real key. .env is gitignored and
# never read by anything other than this process (python-dotenv loads it
# into the environment at startup) -- never commit it, never paste its
# contents anywhere.
#
# Calls go through OpenRouter (https://openrouter.ai/api/v1), which is
# OpenAI-Chat-Completions-compatible and proxies to Anthropic's Claude
# models under an "anthropic/..." model slug -- see agent/llm_client.py.
OPENROUTER_API_KEY=

# Model tiering (agent/llm_client.py) -- cheap tier for high-volume/
# low-judgment calls (scope-check, understanding), strong tier for the one
# narration/judgment/review step and the offline judge. Swappable without
# touching call sites -- APPROACH.md's config-over-code seam. These are
# OpenRouter model slugs, not raw Anthropic model IDs.
MODEL_CHEAP=anthropic/claude-haiku-4.5
MODEL_STRONG=anthropic/claude-sonnet-5

# Dedup-clustering embeddings (agent/dedup.py, §3.5) -- a hosted proprietary
# model over the same OpenRouter client/key, not a local model. See
# SKILLS.md #14 for why (a local sentence-transformers model made the
# Docker build take >20 minutes on this machine, entirely from torch).
MODEL_EMBEDDING=openai/text-embedding-3-small

# Where agent/cache.py's sqlite cache lives (per-video_id understanding
# records, §8). Relative to the repo root.
CACHE_PATH=outputs/cache.sqlite3

# Google Books API key (agent/recommendations.py, the UI-only "while you
# waited" book suggestions). Optional: keyless calls work but on a tiny
# anonymous per-IP daily quota that can 429; a free key from Google Cloud
# Console ("Books API") raises the ceiling. Leave blank to skip.
GOOGLE_BOOKS_API_KEY=

# Optional LangSmith observability. LangGraph auto-traces the pipeline, and
# agent/llm_client.py wraps the OpenAI client so each raw model call is its
# own span. Set LANGCHAIN_TRACING_V2=true and LANGCHAIN_API_KEY to enable;
# leave the key blank to disable tracing entirely. LANGCHAIN_PROJECT is the
# project name the runs appear under in the LangSmith UI.
LANGCHAIN_TRACING_V2=
LANGCHAIN_API_KEY=
LANGCHAIN_PROJECT=youtube_agent
# Only set if your workspace is EU-hosted (the US endpoint returns 403
# otherwise); leave blank for the default US instance.
LANGSMITH_ENDPOINT=
